{
  "schema_version": "rcc.validation_test_policy.v1",
  "version": 1,
  "repository": "jenshaberle-dotcom/job-application-pipeline",
  "suites": {
    "full": {
      "commands": [
        [
          "{python}",
          "-m",
          "pytest",
          "-q",
          "tests"
        ]
      ],
      "paths": [],
      "requires": []
    },
    "census": {
      "commands": [
        [
          "{python}",
          "-m",
          "pytest",
          "-q",
          "tests/test_connector_mass_census.py",
          "tests/test_connector_corpus_scope.py",
          "tests/test_discovery_coverage.py",
          "tests/test_public_directory_discovery.py",
          "tests/test_multi_region_discovery_contracts.py",
          "tests/test_hannover_tech_discovery.py",
          "tests/test_connector_lab_replay_guards.py"
        ]
      ],
      "paths": [
        "src/search_intelligence/connector_mass_census.py",
        "src/search_intelligence/connector_corpus_scope.py",
        "src/search_intelligence/discovery_coverage.py",
        "scripts/discover",
        "scripts/run_multi_region_company_discovery.py",
        "contracts/discovery/"
      ],
      "requires": []
    },
    "factory": {
      "commands": [
        [
          "{python}",
          "-m",
          "pytest",
          "-q",
          "tests/test_aggressive_connector_factory.py",
          "tests/test_connector_factory_aggressive_policy.py"
        ]
      ],
      "paths": [
        "src/connectors/",
        "contracts/connector-capability"
      ],
      "requires": []
    },
    "ml_replay": {
      "commands": [
        [
          "{python}",
          "-m",
          "pytest",
          "-q",
          "tests/test_connector_ml_corpus_pipeline.py"
        ]
      ],
      "paths": [
        "scripts/materialize",
        "scripts/evaluate_connector",
        "contracts/connector-ml"
      ],
      "requires": [
        "census"
      ]
    },
    "rcc_contracts": {
      "commands": [
        [
          "{python}",
          "-m",
          "pytest",
          "-q",
          "tests/test_rcc_runtime_context.py",
          "tests/test_rcc_package_set.py"
        ]
      ],
      "paths": [
        ".rcc/",
        ".github/workflows/",
        "scripts/resolve_rcc"
      ],
      "requires": []
    }
  },
  "actions": {
    "pr_validation": {
      "required": [
        "full"
      ],
      "default": [],
      "allow_omit": false,
      "impact_selection": false
    },
    "merge": {
      "required": [
        "full"
      ],
      "default": [],
      "allow_omit": false,
      "impact_selection": false
    },
    "diagnostic": {
      "required": [
        "census"
      ],
      "default": [
        "factory",
        "ml_replay",
        "rcc_contracts"
      ],
      "allow_omit": true,
      "impact_selection": false
    }
  },
  "effect_semantics": "validation-only"
}
